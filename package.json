{
  "name": "guarded-rollout-demo",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "npm --prefix src/client install",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc",
    "build:client": "npm --prefix src/client run build",
    "start": "concurrently -k -n server,client -c blue,magenta \"npm:start:server\" \"npm:start:client\"",
    "start:server": "node --env-file=.env dist/server.js",
    "start:client": "npm --prefix src/client run preview",
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon --watch 'src/server/**/*.ts' --exec 'node --env-file=.env -r ts-node/register' src/server/server.ts",
    "dev:client": "npm --prefix src/client run dev",
    "lint": "eslint 'src/**/*.ts'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@launchdarkly/node-server-sdk": "^9.10.1",
    "@launchdarkly/observability-node": "^1.3.0",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.32.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
